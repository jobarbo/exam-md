---
/**
 * Course Page
 * Displays the quiz of one course, with navigation to the other courses
 */

import MainLayout from "../../layouts/MainLayout.astro";
import DynamicExam from "../../components/exams/DynamicExam.astro";
import {getCourses, getCourse, EXAM_TITLE, MODULES} from "../../utils/markdown";

export function getStaticPaths() {
	return getCourses().map((course) => ({params: {chapterId: course.id}}));
}

const {chapterId} = Astro.params;
const course = chapterId ? getCourse(chapterId) : undefined;

if (!course) {
	return Astro.redirect("/404");
}

const courses = getCourses().filter((c) => c.hasExam);
const currentIndex = courses.findIndex((c) => c.id === course.id);
const prevCourse = currentIndex > 0 ? courses[currentIndex - 1] : null;
const nextCourse = currentIndex < courses.length - 1 ? courses[currentIndex + 1] : null;
const module = MODULES.find((m) => m.id === course.module);
const pageTitle = `Cours ${course.number} – ${course.title}`;
const eyebrow = `${module ? `${module.title} · ` : ""}Cours ${currentIndex + 1} sur ${courses.length}`;
---

<MainLayout title={`${pageTitle} | ${EXAM_TITLE}`}>
	<div class='course-page'>
		<nav class='breadcrumbs' aria-label="Fil d'Ariane">
			<a href='/'>Accueil</a>
			<span aria-hidden='true'>/</span>
			<span class='breadcrumb-module'>{module ? module.subtitle : EXAM_TITLE}</span>
			<span aria-hidden='true' class='breadcrumb-module'>/</span>
			<span aria-current='page'>Cours {course.number}</span>
		</nav>

		<DynamicExam examId={course.id} title={course.title} eyebrow={eyebrow} sampleSize={5} />

		<nav class='course-nav' aria-label='Navigation entre les cours'>
			{
				prevCourse ? (
					<a href={`/chapitres/${prevCourse.id}`} class='course-nav-link prev'>
						<span class='course-nav-label'>
							<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
								<path d='m12 19-7-7 7-7' />
								<path d='M19 12H5' />
							</svg>
							Cours précédent
						</span>
						<span class='course-nav-title'>
							Cours {prevCourse.number} – {prevCourse.title}
						</span>
					</a>
				) : (
					<a href='/' class='course-nav-link prev'>
						<span class='course-nav-label'>
							<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
								<path d='m12 19-7-7 7-7' />
								<path d='M19 12H5' />
							</svg>
							Retour
						</span>
						<span class='course-nav-title'>Tous les cours</span>
					</a>
				)
			}

			{
				nextCourse ? (
					<a href={`/chapitres/${nextCourse.id}`} class='course-nav-link next'>
						<span class='course-nav-label'>
							Cours suivant
							<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
								<path d='M5 12h14' />
								<path d='m12 5 7 7-7 7' />
							</svg>
						</span>
						<span class='course-nav-title'>
							Cours {nextCourse.number} – {nextCourse.title}
						</span>
					</a>
				) : (
					<a href='/' class='course-nav-link next'>
						<span class='course-nav-label'>
							Terminé
							<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
								<path d='M5 12h14' />
								<path d='m12 5 7 7-7 7' />
							</svg>
						</span>
						<span class='course-nav-title'>Tous les cours</span>
					</a>
				)
			}
		</nav>
	</div>
</MainLayout>

<style>
	.course-page {
		max-width: 820px;
		margin: 0 auto;
	}

	.breadcrumbs {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 2rem;
		font-size: 0.85rem;
		color: var(--text-subtle);
	}

	.breadcrumbs a {
		color: var(--text-muted);
	}

	.breadcrumbs a:hover {
		color: var(--accent);
	}

	.breadcrumbs [aria-current="page"] {
		color: var(--text);
		font-weight: 500;
	}

	.course-nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-top: 3rem;
	}

	.course-nav-link {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 1.1rem 1.25rem;
		border-radius: var(--radius-lg);
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--text);
		transition:
			border-color var(--transition-normal) var(--ease),
			box-shadow var(--transition-normal) var(--ease);
	}

	.course-nav-link:hover {
		color: var(--text);
		border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
		box-shadow: var(--shadow-md);
	}

	.course-nav-link.next {
		text-align: right;
		align-items: flex-end;
	}

	.course-nav-label {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-subtle);
	}

	.course-nav-link:hover .course-nav-label {
		color: var(--accent);
	}

	.course-nav-title {
		font-weight: 600;
		line-height: 1.35;
	}

	@media (max-width: 640px) {
		.breadcrumb-module {
			display: none;
		}

		.breadcrumbs {
			margin-bottom: 1.25rem;
		}

		.course-nav {
			grid-template-columns: 1fr;
		}

		.course-nav-link.next {
			order: -1;
		}
	}
</style>
