---
/**
 * Home Page
 * Landing page listing every course of the exam, grouped by module
 */

import MainLayout from "../layouts/MainLayout.astro";
import ChapterCard from "../components/ChapterCard.astro";
import type {ChapterType} from "../types/chapter";
import {getAllChapters, MODULES, EXAM_TITLE} from "../utils/markdown";

const chapters = (await getAllChapters()) as ChapterType[];
const firstChapter = chapters.find((chapter) => chapter.hasExam);
const courseCount = chapters.filter((chapter) => chapter.hasExam).length;
---

<MainLayout title={`Quiz Pratique - ${EXAM_TITLE}`} description='Quiz de révision pour l’examen 1 sur le vieillissement'>
	<section class='hero'>
		<span class='eyebrow'>Révision</span>
		<h1>{EXAM_TITLE}</h1>
		<p class='hero-lead'>
			Un quiz par cours pour réviser la matière des notes et des lectures. Chaque réponse est expliquée et renvoie à sa source, avec la page.
		</p>

		<ul class='hero-facts' aria-label='Fonctionnement des quiz'>
			<li>
				<strong>{courseCount}</strong>
				<span>cours</span>
			</li>
			<li>
				<strong>5</strong>
				<span>questions tirées au hasard parmi 10</span>
			</li>
			<li>
				<strong>100&nbsp;%</strong>
				<span>des réponses sourcées</span>
			</li>
		</ul>

		{
			firstChapter && (
				<a href={`/chapitres/${firstChapter.id}`} class='btn btn-primary hero-cta'>
					Commencer par le Cours {firstChapter.number}
					<svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
						<path d='M5 12h14' />
						<path d='m12 5 7 7-7 7' />
					</svg>
				</a>
			)
		}
	</section>

	{
		MODULES.map((module) => (
			<section class='module' aria-labelledby={`module-${module.id}`}>
				<header class='module-header'>
					<span class='eyebrow'>{module.title}</span>
					<h2 id={`module-${module.id}`}>{module.subtitle}</h2>
				</header>
				<div class='chapter-grid'>
					{chapters
						.filter((chapter) => chapter.module === module.id)
						.map((chapter) => (
							<ChapterCard {...chapter} />
						))}
				</div>
			</section>
		))
	}
</MainLayout>

<style>
	.hero {
		padding: 2.5rem 0 3.5rem;
		max-width: 760px;
		animation: fadeIn 0.5s var(--ease) both;
	}

	.hero h1 {
		margin: 0.75rem 0 1rem;
	}

	.hero-lead {
		font-size: 1.15rem;
		color: var(--text-muted);
		max-width: 620px;
	}

	.hero-facts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		list-style: none;
		margin: 2rem 0;
	}

	.hero-facts li {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		padding: 0.6rem 1rem;
		border-radius: var(--radius-md);
		background: var(--surface);
		border: 1px solid var(--border);
		font-size: 0.9rem;
		color: var(--text-muted);
	}

	.hero-facts strong {
		font-family: var(--font-display);
		font-size: 1.35rem;
		font-weight: 500;
		color: var(--text);
	}

	.hero-cta svg {
		transition: transform var(--transition-fast) var(--ease);
	}

	.hero-cta:hover svg {
		transform: translateX(3px);
	}

	.module {
		padding-top: 2.5rem;
		border-top: 1px solid var(--border);
		margin-bottom: 3rem;
	}

	.module-header {
		margin-bottom: 1.5rem;
	}

	.module-header h2 {
		margin-top: 0.4rem;
		font-size: clamp(1.35rem, 1vw + 1rem, 1.75rem);
	}

	.chapter-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 1rem;
	}

	@media (max-width: 640px) {
		.hero {
			padding: 1rem 0 2.5rem;
		}

		.hero-lead {
			font-size: 1.05rem;
		}

		.hero-facts li {
			width: 100%;
		}

		.hero-cta {
			width: 100%;
		}

		.chapter-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
