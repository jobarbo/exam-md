---
/**
 * Dynamic Exam Component
 * Loads and displays exam questions dynamically based on exam ID
 */

import ExamForm from "../exam/ExamForm.astro";
import Question from "../exam/Question.astro";
import RadioOption from "../exam/RadioOption.astro";
import CheckboxOption from "../exam/CheckboxOption.astro";
import ExamStyle from "../exam/ExamStyle.astro";
import type {Question as QuestionType, ExamData} from "../../types/exam";

export interface Props {
	examId: string;
	title: string;
	description?: string;
	sampleSize?: number;
}

const {examId, title, description, sampleSize} = Astro.props;

// Load exam data dynamically
const examModule = await import(`../../data/exams/exam${examId}.ts`);
const examData = examModule[`exam${examId}Data`] as ExamData;

if (!examData) {
	throw new Error(`Exam data not found for exam${examId}`);
}

const {questions, correctRadioAnswers, correctCheckboxAnswers} = examData;

// Function to shuffle question options
function shuffleQuestionOptions(questions: QuestionType[]): QuestionType[] {
	return questions.map((question) => ({
		...question,
		options: [...question.options].sort(() => Math.random() - 0.5),
	}));
}

// Shuffle options for all questions
const shuffledQuestions = shuffleQuestionOptions(questions);

// Default descriptions for each exam
const defaultDescriptions: Record<string, string> = {
	"101": "Ce questionnaire porte sur la formation en gérontologie : le CREGÉS et la formation de la relève, ainsi que les lectures de Dridi (2012), Leclerc (2000) et Rousseau-Tremblay et Couturier (2012). 5 questions sont tirées au hasard parmi 10.",
	"102": "Ce questionnaire porte sur les principales théories en gérontologie sociale (rôles, désengagement, activité, continuité, sous-culture, échange social, économie politique, parcours de vie) et sur l'âgisme selon Lagacé (2013). 5 questions sont tirées au hasard parmi 10.",
	"103": "Ce questionnaire porte sur les aspects démographiques du vieillissement : portrait des aînés au Québec (ISQ), vidéo de l'AFP, Légaré (2009) et Statistique Canada (2022). 5 questions sont tirées au hasard parmi 10.",
	"104": "Ce questionnaire porte sur le vieillissement biologique (sénescence, théories intrinsèques et extrinsèques), le vieillissement en santé selon Cardinal et al. (2008) et la maladie d'Alzheimer selon Phaneuf (2007). 5 questions sont tirées au hasard parmi 10.",
	"105": "Ce questionnaire porte sur les aspects psychologiques du vieillissement selon Hétu (2016) : autonomie et bien-être, modèles du cycle de vie, transitions et crises, ainsi que le deuil chez les aînés. 5 questions sont tirées au hasard parmi 10.",
	"106": "Ce questionnaire porte sur les aspects sociaux du vieillissement : soutien social, horloge sociale, âgisme (conférence de Lagacé) et exclusion sociale selon Billette et Lavoie (2010). 5 questions sont tirées au hasard parmi 10.",
};

const examDescription = description || defaultDescriptions[examId] || "";
---

<ExamForm examId={examId} title={title} correctRadioAnswers={correctRadioAnswers} correctCheckboxAnswers={correctCheckboxAnswers} sampleSize={sampleSize}>
	<p class='description'>{examDescription}</p>

	{
		shuffledQuestions.map((q) => (
			<Question id={q.id} title={q.title} question={q.question} explanation={q.explanation} type={q.type}>
				{q.type === "radio" && q.options.map((option) => <RadioOption id={`${q.id}-${option.value}`} name={q.id} value={option.value} label={option.label} />)}
				{q.type === "checkbox" && q.options.map((option) => <CheckboxOption id={`${q.id}-${option.value}`} name={q.id} value={option.value} label={option.label} />)}
			</Question>
		))
	}

	<ExamStyle />
</ExamForm>
