---
/**
 * Chapter Card Component
 * Displays a course with its number, title and quiz status
 */

import Card from './ui/Card.astro';
import type { ChapterType } from '../types/chapter';

export interface Props extends ChapterType {}

const { id, number, title, hasExam, isSpecial } = Astro.props;
---

<Card href={hasExam ? `/chapitres/${id}` : undefined} disabled={!hasExam} special={isSpecial}>
	<div class="card-top">
		<span class="course-number">{String(number).padStart(2, "0")}</span>
		<span class="course-label">Cours {number}</span>
	</div>
	<h3>{title}</h3>
	<div class="card-bottom">
		{
			hasExam ? (
				<span class="exam-badge available">5 questions · banque de 10</span>
			) : (
				<span class="exam-badge unavailable">En préparation</span>
			)
		}
		{hasExam && (
			<svg class="card-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M5 12h14" />
				<path d="m12 5 7 7-7 7" />
			</svg>
		)}
	</div>
</Card>

<style>
	.card-top {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 1.25rem;
	}

	.course-number {
		font-family: var(--font-display);
		font-size: 2.25rem;
		line-height: 1;
		color: var(--accent);
	}

	.course-label {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-subtle);
	}

	h3 {
		font-size: 1.15rem;
		line-height: 1.35;
		margin-bottom: 1.5rem;
		flex-grow: 1;
	}

	.card-bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.exam-badge {
		font-size: 0.8rem;
		font-weight: 500;
		padding: 0.3rem 0.65rem;
		border-radius: 999px;
	}

	.exam-badge.available {
		background: var(--accent-soft);
		color: var(--accent);
	}

	.exam-badge.unavailable {
		background: var(--surface-2);
		color: var(--text-subtle);
	}

	.card-arrow {
		color: var(--text-subtle);
		transition:
			transform var(--transition-fast) var(--ease),
			color var(--transition-fast) var(--ease);
	}

	:global(a.card:hover) .card-arrow {
		color: var(--accent);
		transform: translateX(3px);
	}
</style>
