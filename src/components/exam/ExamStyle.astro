---
// Ce composant fournit les styles communs pour les questions, options et explications
---

<style is:global>
	/* Exam description */
	.description {
		margin-top: 1rem;
		margin-bottom: 0;
		font-size: 1.05rem;
		color: var(--text-muted);
		max-width: 680px;
	}

	/* Question card */
	.question {
		position: relative;
		padding: 1.5rem;
		margin-bottom: 1rem;
		border-radius: var(--radius-lg);
		background: var(--surface);
		border: 1px solid var(--border);
		transition: border-color var(--transition-normal) var(--ease);
	}

	.question.is-answered {
		border-color: var(--border-strong);
	}

	.question.flagged {
		border-color: color-mix(in srgb, var(--warning) 55%, var(--border));
		box-shadow: inset 3px 0 0 var(--warning);
	}

	.question-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.75rem;
	}

	.question-header h3 {
		margin: 0;
		font-family: var(--font-sans);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.question-controls {
		display: flex;
		align-items: center;
	}

	/* The number duplicates the title; kept for the script, hidden visually */
	.question-number {
		display: none;
	}

	.flag-button {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		height: 32px;
		padding: 0 0.6rem;
		border-radius: 999px;
		border: 1px solid transparent;
		background: transparent;
		color: var(--text-subtle);
		cursor: pointer;
		font: 500 0.8rem/1 var(--font-sans);
		transition:
			color var(--transition-fast) var(--ease),
			background-color var(--transition-fast) var(--ease),
			border-color var(--transition-fast) var(--ease);
	}

	.flag-button::after {
		content: "Marquer";
	}

	.flag-button:hover {
		color: var(--warning);
		background: var(--warning-soft);
	}

	.flag-button.active {
		color: var(--warning);
		background: var(--warning-soft);
		border-color: color-mix(in srgb, var(--warning) 35%, transparent);
	}

	.flag-button.active::after {
		content: "Marquée";
	}

	.flag-button svg {
		width: 14px;
		height: 14px;
	}

	.question .question-text {
		margin-bottom: 1.25rem;
		font-size: 1.125rem;
		font-weight: 600;
		line-height: 1.5;
		color: var(--text);
	}

	.question-hint {
		display: inline-flex;
		margin-bottom: 1rem;
		padding: 0.3rem 0.7rem;
		border-radius: 999px;
		background: var(--accent-soft);
		color: var(--accent);
		font-size: 0.8rem;
		font-weight: 500;
	}

	.question-hint strong {
		display: none;
	}

	/* Options */
	.options {
		display: grid;
		gap: 0.5rem;
		counter-reset: option;
	}

	.option {
		position: relative;
		display: flex;
		align-items: flex-start;
		gap: 0.85rem;
		padding: 0.8rem 1rem;
		border-radius: var(--radius-md);
		border: 1px solid var(--border);
		background: var(--surface);
		counter-increment: option;
		transition:
			border-color var(--transition-fast) var(--ease),
			background-color var(--transition-fast) var(--ease);
	}

	/* Letter badge (A, B, C…) acts as the radio/checkbox indicator */
	.option::before {
		content: counter(option, upper-alpha);
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 28px;
		height: 28px;
		border-radius: 999px;
		border: 1px solid var(--border-strong);
		background: var(--surface);
		color: var(--text-muted);
		font-size: 0.8rem;
		font-weight: 700;
		transition: all var(--transition-fast) var(--ease);
	}

	.option:has(input[type="checkbox"])::before {
		border-radius: 7px;
	}

	/* The native input covers the whole row: the full row is clickable and keyboard accessible */
	.option input {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		margin: 0;
		opacity: 0;
		cursor: pointer;
		z-index: 1;
	}

	.option label {
		flex: 1;
		padding-top: 0.15rem;
		line-height: 1.5;
		color: var(--text);
		cursor: pointer;
	}

	.option:hover {
		border-color: var(--border-strong);
		background: var(--surface-2);
	}

	.option:has(input:focus-visible) {
		box-shadow: var(--focus-ring);
	}

	.option:has(input:checked) {
		border-color: var(--accent);
		background: var(--accent-soft);
	}

	.option:has(input:checked)::before {
		border-color: var(--accent);
		background: var(--accent);
		color: var(--accent-contrast);
	}

	/* After validation */
	.options .option.correct-option {
		border-color: var(--success);
		background: var(--success-soft);
	}

	.options .option.correct-option::before {
		border-color: var(--success);
		background: var(--success);
		color: var(--surface);
	}

	.options .option.incorrect-option {
		border-color: var(--danger);
		background: var(--danger-soft);
	}

	.options .option.incorrect-option::before {
		border-color: var(--danger);
		background: var(--danger);
		color: var(--surface);
	}

	.option.correct-option::after,
	.option.incorrect-option::after {
		align-self: center;
		flex-shrink: 0;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		animation: fadeIn 0.3s var(--ease);
	}

	.option.correct-option::after {
		content: "✓ Bonne réponse";
		color: var(--success);
	}

	.option.incorrect-option::after {
		content: "✕ Votre choix";
		color: var(--danger);
	}

	/* Explanation */
	.explanation {
		display: none;
		margin-top: 1.25rem;
		padding: 1rem 1.25rem;
		border-radius: var(--radius-md);
		background: var(--surface-2);
		font-size: 0.95rem;
		line-height: 1.65;
	}

	.explanation.visible {
		display: block;
		animation: fadeIn 0.35s var(--ease);
	}

	.explanation-header {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin-bottom: 0.4rem;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.explanation-header svg {
		width: 16px;
		height: 16px;
		flex-shrink: 0;
	}

	.explanation-content {
		color: var(--text);
	}

	@media (max-width: 640px) {
		.question {
			padding: 1.1rem;
		}

		.question .question-text {
			font-size: 1.05rem;
		}

		.option {
			padding: 0.75rem 0.85rem;
			flex-wrap: wrap;
		}

		.option.correct-option::after,
		.option.incorrect-option::after {
			width: 100%;
			padding-left: calc(28px + 0.85rem);
		}

		.flag-button::after {
			content: none;
		}

		.flag-button.active::after {
			content: none;
		}
	}
</style>
